prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@PKGCONFIG_TARGET_LIBS@
includedir=@PKGCONFIG_TARGET_INCLUDES@

Name: libpdfcore_jpegli_threads
Description: JPEGLI multi-thread runner using std::threads.
Version: @PDFCORE_LIBRARY_VERSION@
@PDFCORE_REQUIRES_TYPE@: @PDFCORE_THREADS_LIBRARY_REQUIRES@
Libs: -L${libdir} -lpdfcore_jpegli_threads
Libs.private: -lm
Cflags: -I${includedir}
Cflags.private: -DPDFCORE_THREADS_STATIC_DEFINE
