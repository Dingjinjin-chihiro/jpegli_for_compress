prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@PKGCONFIG_TARGET_LIBS@
includedir=@PKGCONFIG_TARGET_INCLUDES@

Name: libpdfcore_jpegli_cms
Description: CMS support library for libjpegli
Version: @PDFCORE_LIBRARY_VERSION@
@PDFCORE_REQUIRES_TYPE@: @PDFCORE_CMS_LIBRARY_REQUIRES@
Libs: -L${libdir} -lpdfcore_jpegli_cms @PDFCORE_CMS_PUBLIC_LIBS@
Libs.private: @PDFCORE_CMS_PRIVATE_LIBS@
Cflags: -I${includedir}
Cflags.private: -DPDFCORE_CMS_STATIC_DEFINE
